// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════
// 1. TENANCY & ROLE SYSTEM
// ═══════════════════════════════════════

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  customDomain String?      @map("custom_domain")
  brandLogoUrl String?      @map("brand_logo_url")
  primaryColor String       @default("#1A4E8C") @map("primary_color")
  status       TenantStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users              User[]
  devices            Device[]
  deviceGroups       DeviceGroup[]
  playerRegistrations PlayerRegistration[]
  media              Media[]
  mediaCategories    MediaCategory[]
  playlists          Playlist[]
  playlistCategories PlaylistCategory[]
  calendars          Calendar[]
  auditLogs          AuditLog[]
  tags               Tag[]
  subscriptions      Subscription[]
  payments           Payment[]
  invoices           Invoice[]
  tickets            Ticket[]
  roles              Role[]
  featureOverrides   TenantFeature[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roleId              String               @map("role_id")
  role                Role                 @relation(fields: [roleId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  assignedTickets     Ticket[]             @relation("TicketAssignedToUser")
  tickets             Ticket[]             @relation("TicketCreatedByUser")
  playerRegistrations PlayerRegistration[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  scope       RoleScope @default(TENANT)
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions Permission[] @relation("RolePermissions")

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  key         String    @unique
  scope       RoleScope @default(TENANT)
  resource    String
  action      String
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  roles Role[] @relation("RolePermissions")

  @@map("permissions")
}

// ═══════════════════════════════════════
// 2. CONTENT & DEVICE PLATFORM
// ═══════════════════════════════════════

model Media {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  name        String
  filename    String
  s3Key       String      @map("s3_key")
  cdnUrl      String      @map("cdn_url")
  sourceType  String      @default("upload") @map("source_type")
  externalUrl String?     @map("external_url")
  sizeBytes   BigInt      @map("size_bytes")
  durationSec Int?        @map("duration_sec")
  width       Int?
  height      Int?
  status      MediaStatus @default(PROCESSING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  mediaTypeId   String          @map("media_type_id")
  mediaType     MediaType       @relation(fields: [mediaTypeId], references: [id])
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories    MediaCategory[] @relation("MediaToCategory")
  tags          Tag[]           @relation("MediaToTag")
  playlistItems PlaylistItem[]

  @@map("media")
}

model MediaType {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "video", "image", "html"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  media Media[]

  @@map("media_types")
}

model MediaCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  media  Media[] @relation("MediaToCategory")

  @@unique([tenantId, name])
  @@map("media_categories")
}

model Playlist {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  displayName   String   @default("Landscape 16:9") @map("display_name")
  displayWidth  Int      @default(1920) @map("display_width")
  displayHeight Int      @default(1080) @map("display_height")
  layoutMode    String   @default("zone") @map("layout_mode")
  gridRows      Int      @default(3) @map("grid_rows")
  gridColumns   Int      @default(3) @map("grid_columns")
  zonesJson     Json?    @map("zones_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories    PlaylistCategory[] @relation("PlaylistToCategory")
  tags          Tag[]              @relation("PlaylistToTag")
  playlistItems PlaylistItem[]
  devices       Device[]
  deviceGroups  DeviceGroup[]
  calendars     Calendar[]

  @@map("playlists")
}

model PlaylistCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playlists Playlist[] @relation("PlaylistToCategory")

  @@unique([tenantId, name])
  @@map("playlist_categories")
}

model PlaylistItem {
  id             String   @id @default(uuid())
  playlistId     String   @map("playlist_id")
  mediaId        String   @map("media_id")
  position       Int
  durationSec    Int      @map("duration_sec")
  fit            String   @default("scale-down")
  objectPosition String   @default("center") @map("object_position")
  zoneId         String   @default("full-screen") @map("zone_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("playlist_items")
}

model Calendar {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  playlistId  String         @map("playlist_id")
  name        String
  description String?
  startTime   DateTime       @map("start_time")
  endTime     DateTime       @map("end_time")
  daysOfWeek  Int[]          @map("days_of_week") // e.g. [1,2,3,4,5] (Monday=1, Sunday=7)
  priority    Int            @default(0)
  status      CalendarStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  devices  Device[] @relation("CalendarToDevice")

  @@map("calendars")
}

model Device {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  serialNumber    String        @unique @map("serial_number")
  deviceToken     String        @map("device_token")
  model           String
  name            String
  location        String?
  firmwareVersion String?       @map("firmware_version")
  lastSeen        DateTime?     @map("last_seen")
  status          DeviceStatus  @default(OFFLINE)
  storagePercent  Int?          @map("storage_percent")
  alertsCount     Int           @default(0) @map("alerts_count")
  alertsSeverity  AlertSeverity @default(NONE) @map("alerts_severity")
  installId       String?       @unique @map("install_id")
  platform        PlayerPlatform?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  currentPlaylistId String?      @map("current_playlist_id")
  playerRegistrationId String?   @unique @map("player_registration_id")
  playerRegistration   PlayerRegistration? @relation(fields: [playerRegistrationId], references: [id], onDelete: SetNull)
  playlist          Playlist?    @relation(fields: [currentPlaylistId], references: [id], onDelete: SetNull)
  groupId           String?      @map("group_id")
  group             DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags              Tag[]        @relation("DeviceToTag")
  calendars         Calendar[]   @relation("CalendarToDevice")

  @@map("devices")
}

model PlayerRegistration {
  id                String                   @id @default(uuid())
  tenantId          String                   @map("tenant_id")
  agentUserId       String?                  @map("agent_user_id")
  platform          PlayerPlatform
  downloadTokenHash String                   @unique @map("download_token_hash")
  installTokenHash  String                   @unique @map("install_token_hash")
  installId         String?                  @unique @map("install_id")
  deviceId          String?                  @unique @map("device_id")
  hostname          String?
  osVersion         String?                  @map("os_version")
  appVersion        String?                  @map("app_version")
  ipAddress         String?                  @map("ip_address")
  status            PlayerRegistrationStatus @default(DOWNLOADED)
  expiresAt         DateTime                 @map("expires_at")
  downloadedAt      DateTime                 @default(now()) @map("downloaded_at")
  installedAt       DateTime?                @map("installed_at")
  claimedAt         DateTime?                @map("claimed_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentUser User? @relation(fields: [agentUserId], references: [id], onDelete: SetNull)
  device Device?

  @@index([tenantId, status])
  @@index([agentUserId])
  @@map("player_registrations")
}

model DeviceGroup {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  scheduleLabel String?  @map("schedule_label")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  currentPlaylistId String?   @map("current_playlist_id")
  playlist          Playlist? @relation(fields: [currentPlaylistId], references: [id], onDelete: SetNull)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices           Device[]

  @@unique([tenantId, name])
  @@map("device_groups")
}

// ═══════════════════════════════════════
// 3. UTILITIES & TELEMETRY
// ═══════════════════════════════════════

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @map("user_id")
  action      String
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Tag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  media     Media[]    @relation("MediaToTag")
  playlists Playlist[] @relation("PlaylistToTag")
  devices   Device[]   @relation("DeviceToTag")

  @@unique([tenantId, name])
  @@map("tags")
}

// ═══════════════════════════════════════
// 4. BILLING & SUBSCRIPTIONS
// ═══════════════════════════════════════

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique // e.g. "Starter", "Growth", "Business", "Enterprise"
  description  String?
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  currency     String   @default("INR")
  /// Quotas: null means unlimited. Deliberately not a -1 sentinel, which
  /// someone eventually compares with `<` and silently caps Enterprise at -1.
  maxDevices             Int? @map("max_devices")
  maxStorageGb           Int? @map("max_storage_gb")
  maxUsers               Int? @map("max_users")
  maxRules               Int? @map("max_rules")
  analyticsRetentionDays Int? @map("analytics_retention_days")
  /// Fallback plan for tenants with no subscription. Exactly one row carries it.
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  features      PlanFeature[]

  @@map("plans")
}

/// A gated capability. ENTITLEMENT is billing-owned and permanent; FLAG is
/// engineering-owned, carries a global switch plus rollout, and is deleted once
/// the rollout finishes. Both resolve through lib/features.ts.
model Feature {
  id          String      @id @default(uuid())
  key         String      @unique // snake_case, e.g. "proof_of_play_export"
  name        String
  description String?
  kind        FeatureKind @default(ENTITLEMENT)
  /// FLAG only. The kill switch — false beats every plan and every override.
  enabled Boolean? @map("enabled")
  /// FLAG only. 0-100, bucketed on a stable hash of the tenant id.
  rolloutPct Int?     @map("rollout_pct")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plans     PlanFeature[]
  overrides TenantFeature[]

  @@map("features")
}

model PlanFeature {
  planId    String   @map("plan_id")
  featureId String   @map("feature_id")
  createdAt DateTime @default(now()) @map("created_at")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

/// Per-tenant escape hatch, for pilots and off-plan contracts. `enabled` is an
/// explicit on/off — the absence of a row is the "no opinion" case, so this
/// stays a boolean rather than a tri-state.
model TenantFeature {
  tenantId  String   @map("tenant_id")
  featureId String   @map("feature_id")
  enabled   Boolean
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureId])
  @@map("tenant_features")
}

model Subscription {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  planId        String             @map("plan_id")
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @map("start_date")
  endDate       DateTime?          @map("end_date")
  razorpaySubId String?            @unique @map("razorpay_sub_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  subscriptionId String        @map("subscription_id")
  amount         Int
  currency       String        @default("INR")
  status         PaymentStatus @default(SUCCESS)
  gatewayTxnId   String?       @map("gateway_txn_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  subscriptionId String        @map("subscription_id")
  invoiceNumber  String        @unique @map("invoice_number")
  amount         Int
  tax            Int
  status         InvoiceStatus @default(PAID)
  pdfUrl         String?       @map("pdf_url")
  dueDate        DateTime?     @map("due_date")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model PlayerMediaSync {
  mediaId      String    @id @map("media_id")
  localPath    String?   @map("local_path")
  syncStatus   String    @default("pending") @map("sync_status") @db.VarChar(20)
  syncError    String?   @map("sync_error")
  syncAttempts Int       @default(0) @map("sync_attempts")
  syncedAt     DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("player_media_sync")
}

model PlayerPlaylistRender {
  playlistId     String    @id @map("playlist_id")
  sourceHash     String?   @map("source_hash")
  renderStatus   String    @default("pending") @map("render_status") @db.VarChar(20)
  renderError    String?   @map("render_error")
  renderAttempts Int       @default(0) @map("render_attempts")
  outputPath     String?   @map("output_path")
  durationSec    Int?      @map("duration_sec")
  renderedAt     DateTime? @map("rendered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  s3Key          String?   @map("s3_key")
  s3Url          String?   @map("s3_url")

  @@map("player_playlist_render")
}

model Ticket {
  id           String         @id
  tenantId     String         @map("tenant_id")
  userId       String?        @map("user_id")
  assignedToId String?        @map("assigned_to_id")
  title        String
  description  String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @map("updated_at")

  assignedTo User?  @relation("TicketAssignedToUser", fields: [assignedToId], references: [id])
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?  @relation("TicketCreatedByUser", fields: [userId], references: [id])

  @@map("tickets")
}

// ═══════════════════════════════════════
// 5. ENUMS (STATUSES)
// ═══════════════════════════════════════

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum CalendarStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

enum DeviceStatus {
  ONLINE
  DELAYED
  OFFLINE
}

enum AlertSeverity {
  NONE
  MEDIUM
  HIGH
  CRITICAL
}

enum PlayerPlatform {
  LINUX
  WINDOWS
}

enum PlayerRegistrationStatus {
  DOWNLOADED
  INSTALLED
  CLAIMED
  EXPIRED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum FeatureKind {
  ENTITLEMENT
  FLAG
}
